{
  "schemaVersion": "cineweave.edition-contract.v2",
  "contractVersion": "edition.v2",
  "editions": [
    "community",
    "cloud"
  ],
  "operationalModes": [
    "normal",
    "commercial_restricted"
  ],
  "restrictionReasons": [
    "internal_release_mismatch",
    "commercial_writes_frozen"
  ],
  "featureKeys": [
    "core.workflow",
    "core.provider_gateway",
    "core.self_hosting",
    "billing.shadow_account",
    "billing.balance",
    "billing.top_up",
    "billing.subscription",
    "billing.organization_wallet",
    "billing.reconciliation",
    "billing.invoice",
    "governance.sso",
    "governance.scim",
    "governance.audit_export",
    "operations.supported_ha_tooling",
    "operations.managed_disaster_recovery"
  ],
  "denialCodes": [
    "feature_unknown",
    "feature_not_compiled",
    "internal_release_mismatch",
    "commercial_writes_frozen",
    "plan_entitlement_required",
    "billing_account_suspended",
    "permission_denied",
    "billing_binding_invalid",
    "billing_account_scope_mismatch",
    "billing_authority_mismatch",
    "billing_sponsorship_required",
    "billing_routing_candidate_missing",
    "billing_insufficient_balance",
    "billing_credential_unavailable",
    "billing_model_forbidden",
    "billing_upstream_unavailable"
  ],
  "providerManagementScopes": [
    "tenant_managed",
    "system_managed"
  ],
  "billingAccountScopes": [
    "organization",
    "personal"
  ],
  "apiResourceScopes": [
    "organization",
    "workspace",
    "project"
  ],
  "commercialOperations": [
    "read_or_export",
    "core_operation",
    "commercial_write",
    "paid_provider_create",
    "async_poll_or_cancel",
    "finalization",
    "idempotent_recovery"
  ],
  "goInterfaces": {
    "EditionProvider": [
      "Manifest",
      "OperationalState"
    ],
    "EntitlementService": [
      "Evaluate"
    ],
    "BillingRoutingAuthorizer": [
      "Authorize"
    ],
    "CommercialModuleRegistry": [
      "APIModules",
      "EventConsumers",
      "BackgroundTasks"
    ]
  },
  "webEditionEntrySlots": [
    "contractVersion",
    "navigation",
    "routes",
    "queryClients",
    "entitlementGuards",
    "topBarItems"
  ],
  "apiModuleRegistration": {
    "requiredFields": [
      "ModuleKey",
      "FeatureKey",
      "Method",
      "Pattern",
      "OperationID",
      "Operation",
      "RequiredPermissions",
      "ResourceScope",
      "ResourcePathParameter",
      "Handler"
    ],
    "authorizationOrder": [
      "CoreAuthentication",
      "InternalReleaseAndTenantEntitlement",
      "CoreRBAC",
      "ResourceState",
      "Handler"
    ],
    "commercialRoutesRequireAuthentication": true,
    "commercialRoutesRequireRBAC": true,
    "commercialRoutesRequireManifestModule": true
  },
  "effectiveSpendAuthorization": {
    "allOf": [
      "ProjectOperationAllowedByRBAC",
      "BillingSpendAllowedByRBACForProject",
      "ActiveBindingMatchesContextRevision",
      "AccountScopeCondition"
    ],
    "organizationAccountScopeCondition": [
      "AccountAndProjectSameOrganization"
    ],
    "personalAccountScopeCondition": [
      "AccountOwnerMatchesSponsorshipSponsor",
      "SponsorshipActiveForProjectAndRevision"
    ],
    "sponsorshipCreatesRBACPermission": false
  },
  "billingAuthorityIsolation": {
    "allEqual": [
      "ContextAuthorityRef",
      "AccountAuthorityRef",
      "CredentialAuthorityRef"
    ],
    "sameOrganization": [
      "ContextOrganizationID",
      "AccountOrganizationID",
      "CredentialOrganizationID"
    ],
    "sameBillingAccount": [
      "ContextBillingAccountID",
      "CredentialBillingAccountID"
    ]
  }
}
