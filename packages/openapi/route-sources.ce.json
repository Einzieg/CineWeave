{
  "schemaVersion": "cineweave.route-sources.v1",
  "sources": [
    {
      "path": "internal/api/server.go",
      "parser": "go-http-mux"
    },
    {
      "path": "apps/realtime/main.go",
      "parser": "go-http-mux"
    },
    {
      "path": "internal/providergatewayserver/server.go",
      "parser": "go-http-mux",
      "defaultImplicitMethod": "post"
    }
  ],
  "implicitMethods": {
    "/healthz": "get",
    "/readyz": "get",
    "/api/realtime/events": "get"
  },
  "protocolTransports": [
    {
      "method": "post",
      "path": "/mcp",
      "protocol": "mcp-streamable-http-2026-07-28"
    }
  ],
  "allowMissingOpenAPI": []
}
