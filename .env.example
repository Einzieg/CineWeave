CINEWEAVE_ENV=development
CINEWEAVE_API_ADDR=:8080
CINEWEAVE_REALTIME_ADDR=:8081
CINEWEAVE_PROVIDER_GATEWAY_ADDR=:8082
CINEWEAVE_SERVICE_TOKEN=dev-service-token
CINEWEAVE_JWT_SECRET=dev-insecure-cineweave-secret
CINEWEAVE_CREDENTIAL_MASTER_KEY=
PROVIDER_GATEWAY_URL=http://provider-gateway:8082
CINEWEAVE_PROVIDER_TEXT_TIMEOUT_MS=600000
CINEWEAVE_PROVIDER_GATEWAY_CLIENT_TIMEOUT_MS=660000
CINEWEAVE_ALLOW_PROVIDER_DIRECT_FALLBACK=false
CINEWEAVE_ALLOW_PUBLIC_REGISTRATION=false
CINEWEAVE_ALLOW_PRIVATE_PROVIDER_MEDIA_URLS=false
CINEWEAVE_PROVIDER_GUARD_SERVICE_NAME=provider-gateway
CINEWEAVE_PROVIDER_VIDEO_MAX_BYTES=536870912

# Docker Compose exposes only browser-facing services by default.
# Database, Redis, NATS, Temporal, Provider Gateway, and MinIO Console stay on the Docker network.
CINEWEAVE_WEB_HOST_PORT=19285
CINEWEAVE_API_HOST_PORT=19288
CINEWEAVE_REALTIME_HOST_PORT=19281
MINIO_API_HOST_PORT=19290

DATABASE_URL=postgres://cineweave:cineweave_dev_password@postgres:5432/cineweave?sslmode=disable
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
TEMPORAL_ADDRESS=temporal:7233
CINEWEAVE_EVENT_PUBLISH_INTERVAL=1s
CINEWEAVE_EVENT_PUBLISH_BATCH=50

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:19290
S3_REGION=us-east-1
S3_BUCKET=cineweave
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_USE_PATH_STYLE=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:19288
NEXT_PUBLIC_REALTIME_URL=http://localhost:19281/api/realtime/events
CINEWEAVE_CORS_ORIGINS=http://localhost:19285,http://127.0.0.1:19285
