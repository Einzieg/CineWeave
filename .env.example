CINEWEAVE_ENV=development
CINEWEAVE_RELEASE_ID=local-dev
CINEWEAVE_API_ADDR=:8080
CINEWEAVE_REALTIME_ADDR=:8081
CINEWEAVE_PROVIDER_GATEWAY_ADDR=:8082
CINEWEAVE_PROVIDER_REQUEST_RECONCILE_INTERVAL=1m
CINEWEAVE_PROVIDER_REQUEST_STALE_AFTER=30m
CINEWEAVE_WORKFLOW_START_POLL_INTERVAL=1s
CINEWEAVE_WORKFLOW_CANCELLATION_RECONCILE_INTERVAL=1s
CINEWEAVE_WORKFLOW_CANCELLATION_RECONCILE_BATCH_SIZE=32
CINEWEAVE_EPISODE_VIDEO_RECONCILE_INTERVAL=1m
CINEWEAVE_EPISODE_VIDEO_STALE_AFTER=10m
CINEWEAVE_EPISODE_VIDEO_RECONCILE_BATCH_SIZE=32
CINEWEAVE_DERIVED_ASSET_RECONCILE_INTERVAL=1m
CINEWEAVE_DERIVED_ASSET_RECONCILE_BATCH_SIZE=32
CINEWEAVE_WORKFLOW_START_LEASE_TIMEOUT=30s
CINEWEAVE_WORKFLOW_START_TIMEOUT=15s
CINEWEAVE_WORKFLOW_START_BATCH_SIZE=16
CINEWEAVE_SERVICE_TOKEN=dev-service-token
CINEWEAVE_JWT_SECRET=dev-insecure-cineweave-secret
CINEWEAVE_TRUSTED_PROXY_CIDRS=
CINEWEAVE_CREDENTIAL_MASTER_KEY=
PROVIDER_GATEWAY_URL=http://provider-gateway:8082
CINEWEAVE_PROVIDER_TEXT_TIMEOUT_MS=600000
CINEWEAVE_PROVIDER_GATEWAY_CLIENT_TIMEOUT_MS=1260000
CINEWEAVE_ALLOW_PROVIDER_DIRECT_FALLBACK=false
CINEWEAVE_PROVIDER_CONFIGURATION_FROZEN=false
VIDEO_PRODUCTION_PROFILES_ENABLED=false
CINEWEAVE_ALLOW_PUBLIC_REGISTRATION=false
CINEWEAVE_PROVIDER_GUARD_SERVICE_NAME=provider-gateway
CINEWEAVE_PROVIDER_IMAGE_TIMEOUT_MS=600000
CINEWEAVE_PROVIDER_IMAGE_REQUEST_TIMEOUT_MS=1200000
CINEWEAVE_PROVIDER_AUDIO_TIMEOUT_MS=600000
CINEWEAVE_PROVIDER_VIDEO_MAX_BYTES=536870912
CINEWEAVE_PROVIDER_VIDEO_MEDIA_TIMEOUT_MS=600000
# Optional outbound proxy used only by Provider Gateway for upstream AI services.
CINEWEAVE_PROVIDER_HTTP_PROXY=
CINEWEAVE_PROVIDER_NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,nats,temporal,minio,provider-gateway,api,realtime

# Docker Compose exposes only browser-facing services by default.
# Database, Redis, NATS, Temporal, Provider Gateway, and MinIO Console stay on the Docker network.
CINEWEAVE_WEB_HOST_PORT=19285
CINEWEAVE_API_HOST_PORT=19288
CINEWEAVE_REALTIME_HOST_PORT=19281
MINIO_API_HOST_PORT=19290

DATABASE_URL=postgres://cineweave:cineweave_dev_password@postgres:5432/cineweave?sslmode=disable
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACE_RETENTION=72h
CINEWEAVE_SOURCE_TO_SCRIPT_STAGING_RETENTION=720h
CINEWEAVE_SOURCE_TO_SCRIPT_PAYLOAD_CLEANUP_INTERVAL=6h
CINEWEAVE_SOURCE_TO_SCRIPT_PAYLOAD_CLEANUP_BATCH_SIZE=100
TEMPORAL_SCHEMA_TIMEOUT=10m
TEMPORAL_WORKER_VERSIONING_ENABLED=true
TEMPORAL_WORKER_DEPLOYMENT_PREFIX=cineweave
CINEWEAVE_INTERNAL_NETWORK=cineweave_internal
CINEWEAVE_EVENT_PUBLISH_INTERVAL=1s
CINEWEAVE_EVENT_PUBLISH_BATCH=50

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:19290
CINEWEAVE_ALLOW_PRIVATE_PROVIDER_REFERENCE_URLS=false
S3_REGION=us-east-1
S3_BUCKET=cineweave
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_USE_PATH_STYLE=true
S3_HTTP_PROXY=
S3_DOWNLOAD_PART_SIZE_BYTES=1048576
S3_DOWNLOAD_CONCURRENCY=8

NEXT_PUBLIC_API_BASE_URL=http://localhost:19288
NEXT_PUBLIC_REALTIME_URL=http://localhost:19281/api/realtime/events
CINEWEAVE_CORS_ORIGINS=http://localhost:19285,http://127.0.0.1:19285
