FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build

ARG CINEWEAVE_GO_BUILD_TAGS=community
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN test "${CINEWEAVE_GO_BUILD_TAGS}" = "community"
RUN CGO_ENABLED=0 go build -trimpath -tags "${CINEWEAVE_GO_BUILD_TAGS}" -o /out/cineweave-migrate ./cmd/cineweave-migrate
RUN CGO_ENABLED=0 go build -trimpath -tags "${CINEWEAVE_GO_BUILD_TAGS}" -o /out/cineweave-seed ./cmd/cineweave-seed
RUN CGO_ENABLED=0 go build -trimpath -tags "${CINEWEAVE_GO_BUILD_TAGS}" -o /out/temporal-release ./cmd/temporal-release

FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d
LABEL org.cineweave.edition="community"
RUN adduser -D -H cineweave
USER cineweave
COPY --from=build /out/cineweave-migrate /cineweave-migrate
COPY --from=build /out/cineweave-seed /cineweave-seed
COPY --from=build /out/temporal-release /temporal-release
