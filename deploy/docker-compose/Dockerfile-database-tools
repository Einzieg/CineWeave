FROM golang:1.26-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/cineweave-migrate ./cmd/cineweave-migrate
RUN CGO_ENABLED=0 go build -trimpath -o /out/cineweave-seed ./cmd/cineweave-seed
RUN CGO_ENABLED=0 go build -trimpath -o /out/temporal-release ./cmd/temporal-release

FROM alpine:3.21
RUN adduser -D -H cineweave
USER cineweave
COPY --from=build /out/cineweave-migrate /cineweave-migrate
COPY --from=build /out/cineweave-seed /cineweave-seed
COPY --from=build /out/temporal-release /temporal-release
