# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build

ARG SERVICE_PATH
ARG CINEWEAVE_GO_BUILD_TAGS=community
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN test "${CINEWEAVE_GO_BUILD_TAGS}" = "community"
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -tags "${CINEWEAVE_GO_BUILD_TAGS}" -o /out/service ./${SERVICE_PATH}

FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d
LABEL org.cineweave.edition="community"
RUN adduser -D -H cineweave
USER cineweave
COPY --from=build /out/service /service
ENTRYPOINT ["/service"]
