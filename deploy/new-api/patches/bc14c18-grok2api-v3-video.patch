+++ b/relay/channel/task/sora/adaptor_grok_test.go
@@ -0,0 +1,100 @@
+package sora
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestGrokImagineVideoModelRecognition(t *testing.T) {
+	require.True(t, isGrokImagineVideo("grok-imagine-video"))
+	require.True(t, isGrokImagineVideo("grok-imagine-video-1.5-preview"))
+	require.False(t, isGrokImagineVideo("omni-fast-no-water"))
+}
+
+func TestValidateGrokImagineVideoRequestAcceptsImageObject(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(recorder)
+	ctx.Request = httptest.NewRequest(http.MethodPost, "/v1/video/generations", strings.NewReader(`{
+		"model":"grok-imagine-video",
+		"prompt":"product turntable",
+		"duration":6,
+		"image":{"url":"https://example.com/reference.png"}
+	}`))
+	ctx.Request.Header.Set("Content-Type", gin.MIMEJSON)
+	info := &relaycommon.RelayInfo{OriginModelName: grokImagineVideoModel, TaskRelayInfo: &relaycommon.TaskRelayInfo{}}
+
+	taskErr := (&TaskAdaptor{}).ValidateRequestAndSetAction(ctx, info)
+
+	require.Nil(t, taskErr)
+	require.Equal(t, constant.TaskActionGenerate, info.Action)
+	taskRequest, err := relaycommon.GetTaskRequest(ctx)
+	require.NoError(t, err)
+	require.Equal(t, 6, taskRequest.Duration)
+	require.Equal(t, []string{"https://example.com/reference.png"}, taskRequest.Images)
+}
+
+func TestBuildRequestURLUsesGrokGenerationEndpoint(t *testing.T) {
+	adaptor := &TaskAdaptor{baseURL: "http://grok2api:8000"}
+	url, err := adaptor.BuildRequestURL(&relaycommon.RelayInfo{OriginModelName: grokImagineVideoModel, TaskRelayInfo: &relaycommon.TaskRelayInfo{}})
+	require.NoError(t, err)
+	require.Equal(t, "http://grok2api:8000/v1/videos/generations", url)
+}
+
+func TestDoResponseAcceptsGrokRequestIDAndReturnsPublicID(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(recorder)
+	resp := &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(`{"request_id":"video_upstream"}`))}
+	info := &relaycommon.RelayInfo{OriginModelName: grokImagineVideoModel, TaskRelayInfo: &relaycommon.TaskRelayInfo{PublicTaskID: "task_public"}}
+
+	taskID, _, taskErr := (&TaskAdaptor{}).DoResponse(ctx, resp, info)
+
+	require.Nil(t, taskErr)
+	require.Equal(t, "video_upstream", taskID)
+	require.JSONEq(t, `{"id":"task_public","task_id":"task_public","request_id":"task_public","object":"","model":"","status":"","progress":0,"created_at":0}`, recorder.Body.String())
+}
+
+func TestParseTaskResultAcceptsGrokDoneStatus(t *testing.T) {
+	result, err := (&TaskAdaptor{}).ParseTaskResult([]byte(`{
+		"status":"done",
+		"video":{"url":"https://grok.example/v1/videos/video_upstream/content"}
+	}`))
+	require.NoError(t, err)
+	require.Equal(t, string(model.TaskStatusSuccess), result.Status)
+	require.Equal(t, "https://grok.example/v1/videos/video_upstream/content", result.Url)
+}
+
+func TestConvertToOpenAIVideoRewritesGrokContentURL(t *testing.T) {
+	originalServerAddress := system_setting.ServerAddress
+	system_setting.ServerAddress = "https://api.example.com/"
+	t.Cleanup(func() { system_setting.ServerAddress = originalServerAddress })
+	task := &model.Task{TaskID: "task_public", Properties: model.Properties{OriginModelName: grokImagineVideoModel}}
+	task.SetData(map[string]any{
+		"request_id": "video_upstream",
+		"status":     "done",
+		"video": map[string]any{
+			"url": "https://grok.example/v1/videos/video_upstream/content",
+		},
+	})
+
+	response, err := (&TaskAdaptor{}).ConvertToOpenAIVideo(task)
+
+	require.NoError(t, err)
+	require.JSONEq(t, `{
+		"id":"task_public",
+		"request_id":"task_public",
+		"status":"done",
+		"video":{"url":"https://api.example.com/v1/videos/task_public/content"}
+	}`, string(response))
+}
