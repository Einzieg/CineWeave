+func validateGrokImagineVideoRequest(c *gin.Context, info *relaycommon.RelayInfo) *dto.TaskError {
+	if !strings.HasPrefix(c.GetHeader("Content-Type"), gin.MIMEJSON) {
+		return service.TaskErrorWrapperLocal(fmt.Errorf("grok video generation only supports application/json"), "invalid_request", http.StatusUnsupportedMediaType)
+	}
+
+	var req struct {
+		Model           string     `json:"model"`
+		Prompt          string     `json:"prompt"`
+		Duration        int        `json:"duration"`
+		Image           *ImageURL  `json:"image"`
+		ReferenceImages []ImageURL `json:"reference_images"`
+	}
+	if err := common.UnmarshalBodyReusable(c, &req); err != nil {
+		return service.TaskErrorWrapperLocal(err, "invalid_request", http.StatusBadRequest)
+	}
+	if strings.TrimSpace(req.Model) == "" {
+		return service.TaskErrorWrapperLocal(fmt.Errorf("field model is required"), "invalid_request", http.StatusBadRequest)
+	}
+
+	images := make([]string, 0, len(req.ReferenceImages)+1)
+	if req.Image != nil && strings.TrimSpace(req.Image.URL) != "" {
+		images = append(images, strings.TrimSpace(req.Image.URL))
+	}
+	for _, image := range req.ReferenceImages {
+		if url := strings.TrimSpace(image.URL); url != "" {
+			images = append(images, url)
+		}
+	}
+	if strings.TrimSpace(req.Prompt) == "" && len(images) == 0 {
+		return service.TaskErrorWrapperLocal(fmt.Errorf("prompt or image is required"), "invalid_request", http.StatusBadRequest)
+	}
+
+	c.Set("task_request", relaycommon.TaskSubmitReq{
+		Model: req.Model, Prompt: req.Prompt, Duration: req.Duration, Images: images,
+	})
+	info.Action = constant.TaskActionTextGenerate
+	if len(images) > 0 {
+		info.Action = constant.TaskActionGenerate
+	}
+	return nil
+}
+
 func (a *TaskAdaptor) ValidateRequestAndSetAction(c *gin.Context, info *relaycommon.RelayInfo) (taskErr *dto.TaskError) {
 	if info.Action == constant.TaskActionRemix {
 		return validateRemixRequest(c)
 	}
+	if isGrokImagineVideo(info.OriginModelName) {
+		return validateGrokImagineVideoRequest(c, info)
+	}
 	return relaycommon.ValidateMultipartDirect(c, info)
 }
 
