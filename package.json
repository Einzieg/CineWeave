{
  "name": "cineweave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @cineweave/web dev",
    "build": "pnpm --filter @cineweave/web build",
    "lint": "pnpm --filter @cineweave/web lint",
    "typecheck": "pnpm --filter @cineweave/web typecheck",
    "test": "node scripts/test.mjs",
    "test:commerce:e2e": "pwsh -NoProfile -File scripts/test-commerce-e2e.ps1",
    "release:check": "pwsh -NoProfile -File scripts/release-check.ps1",
    "release:commerce": "pwsh -NoProfile -File scripts/deploy-commerce-release.ps1",
    "compose:infra": "docker compose --profile infra up -d",
    "compose:full": "docker compose --profile full up -d",
    "compose:down": "docker compose down --remove-orphans"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "postcss": "8.5.22",
      "sharp": "0.35.0"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  }
}
